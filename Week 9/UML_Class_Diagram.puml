@startuml
title Week 9 - Inventory Management System
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

abstract class Product <<abstract>> {
  - __product_id: str
  - __name: str
  - __price: float
  - __stock_quantity: int
  + __init__(product_id, name, price, stock_quantity)
  + update_stock(new_quantity): None
  + display_information(): None
  {abstract} + get_fulfilment_info(): str <<abstract>>
  + product_id: str {get, set}
  + name: str {get, set}
  + price: float {get, set}
  + stock_quantity: int {get, set}
}

interface CanBeShipped <<abstract>> {
  {abstract} + calculate_shipping_cost(): float <<abstract>>
}

class PhysicalProduct {
  - __weight: float
  {static} + SHIPPING_RATE_PER_KG: float = 5.0
  + __init__(product_id, name, price, stock_quantity, weight)
  + display_information(): None
  + get_fulfilment_info(): str
  + calculate_shipping_cost(): float
  + weight: float {get, set}
}

class DigitalProduct {
  - __download_size: float
  + __init__(product_id, name, price, stock_quantity, download_size)
  + display_information(): None
  + get_fulfilment_info(): str
  + download_size: float {get, set}
}

class Inventory {
  - __inventory: Path
  - __all_products: list[Product]
  - __load_failed: bool
  + __init__(inventory_path=None)
  + add_product(product: Product): None
  + search_product(product_id: str): Product | None
  + display_all(): list[Product]
  + load_inventory(): bool
  + save_inventory(): bool
}

Product <|-- PhysicalProduct
Product <|-- DigitalProduct
CanBeShipped <|.. PhysicalProduct
Inventory "0..*" -- "0..*" Product : manages

legend bottom
  + public; - private; {get, set} indicates a Python property.
  Types describe intended values. Constructors omit self.
  Product is the class parent; CanBeShipped is an interface-style ABC.
  Products may be shared between inventories; ownership is not exclusive.
  Subclasses inherit Product's common fields, properties and update_stock().
endlegend
@enduml
